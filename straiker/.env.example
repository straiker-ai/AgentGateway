# Straiker x agentgateway — env template. Copy to .env (gitignored) and fill in real values.
STRAIKER_AGENTGATEWAY_KEY=      # Defend app key -> the "AgentGateway" Console app (selects tenant+app)
STRAIKER_X_TOOL=kong-claude-code # flip to agentgateway-claude-code after the 2-line Argus PR
STRAIKER_MODE=block             # monitor | block  (enforcement is really governed per-control in Console)
STRAIKER_FAIL_OPEN=true
ANTHROPIC_KEY=                  # for the agentic llm surface + local claude runs
OPENAI_API_KEY=                # optional: codex/cursor/opencode/copilot + agentic gpt-*
GEMINI_API_KEY=                # optional: agentic gemini-*
